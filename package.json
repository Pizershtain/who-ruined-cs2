{
  "name": "who-ruined-cs2",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.25.0",
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev --parallel",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test && vitest run tests/golden/real-demo.test.ts",
    "test:golden": "pnpm --filter @who-ruined/features... build && pnpm --filter @who-ruined/match-domain... build && vitest run tests/golden/real-demo.test.ts",
    "parser:probe": "pnpm --filter @who-ruined/parser-adapter probe",
    "validate:demos": "pnpm --filter @who-ruined/validation validate --",
    "score:demos": "pnpm --filter @who-ruined/validation score --",
    "experimental:participation:prepare": "pnpm --filter @who-ruined/worker prepare:participation --",
    "rating:rebuild": "pnpm --filter @who-ruined/worker rating:rebuild --",
    "result:migrate": "pnpm --filter @who-ruined/worker result:migrate --",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "setup:windows": "node scripts/setup-windows.mjs",
    "dev:web": "pnpm --filter @who-ruined/contracts build && pnpm --filter @who-ruined/web dev",
    "gettext": "i18next-cli extract -c apps/web/i18next.config.ts --sync-primary -q",
    "i18n:sync": "tsx apps/web/src/shared/i18n/sync.ts",
    "i18n:check": "i18next-cli extract -c apps/web/i18next.config.ts --sync-primary --dry-run --ci -q && tsx apps/web/src/shared/i18n/sync.ts --check",
    "i18n:compact": "tsx apps/web/src/shared/i18n/compact.ts"
  },
  "devDependencies": {
    "@eslint/js": "9.37.0",
    "@prisma/client": "6.17.1",
    "@types/node": "22.18.8",
    "csgo-protobuf": "4.1.12",
    "eslint": "9.37.0",
    "globals": "16.4.0",
    "prisma": "6.17.1",
    "turbo": "2.5.8",
    "typescript": "5.9.3",
    "typescript-eslint": "8.46.1",
    "vitest": "3.2.4",
    "i18next-cli": "1.74.4",
    "tsx": "4.20.6"
  }
}
