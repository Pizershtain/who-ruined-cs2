{
  "name": "@who-ruined/worker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx watch src/main.ts",
    "start": "node dist/main.js",
    "prepare:c2s2": "tsx src/prepare-c2s2.ts",
    "prepare:participation": "tsx src/prepare-participation.ts",
    "lint": "eslint src test --max-warnings=0",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@who-ruined/contracts": "workspace:*",
    "@who-ruined/database": "workspace:*",
    "@who-ruined/features": "workspace:*",
    "@who-ruined/match-domain": "workspace:*",
    "@who-ruined/parser-adapter": "workspace:*",
    "@who-ruined/scoring": "workspace:*"
  },
  "devDependencies": { "@who-ruined/testkit": "workspace:*", "tsx": "4.20.6" }
}
