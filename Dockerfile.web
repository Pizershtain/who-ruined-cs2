FROM node:22.17.0-bookworm-slim AS build
ENV PNPM_HOME=/pnpm
ENV PATH=$PNPM_HOME:$PATH
RUN corepack enable
WORKDIR /app
COPY . .
RUN pnpm install --frozen-lockfile
RUN pnpm build
RUN install -d -o node -g node /app/apps/web/node_modules/.vite-temp
USER node
CMD ["pnpm", "--filter", "@who-ruined/web", "run", "preview"]
