{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": { "dependsOn": ["^build"], "outputs": ["dist/**"] },
    "generate": { "outputs": ["generated/**"] },
    "@who-ruined/database#generate": { "inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/apps/core/prisma/schema.prisma"], "outputs": ["generated/**"] },
    "@who-ruined/database#build": { "dependsOn": ["generate"], "outputs": ["dist/**"] },
    "@who-ruined/database#typecheck": { "dependsOn": ["generate"] },
    "@who-ruined/profiles#build": { "dependsOn": ["^build", "generate"], "outputs": ["dist/**"] },
    "@who-ruined/profiles#typecheck": { "dependsOn": ["^build", "generate"] },
    "@who-ruined/profiles#test": { "dependsOn": ["build"], "env": ["TEST_DATABASE_URL", "TEST_PROFILES_DATABASE_URL", "REQUIRE_POSTGRES_INTEGRATION"] },
    "@who-ruined/auth#build": { "dependsOn": ["^build", "generate"], "outputs": ["dist/**"] },
    "@who-ruined/auth#typecheck": { "dependsOn": ["^build", "generate"] },
    "@who-ruined/auth#test": { "dependsOn": ["build"], "env": ["TEST_DATABASE_URL", "TEST_AUTH_DATABASE_URL", "REQUIRE_POSTGRES_INTEGRATION"] },
    "dev": { "cache": false, "persistent": true },
    "lint": { "dependsOn": ["^lint"] },
    "typecheck": { "dependsOn": ["^build"] },
    "test": {
      "dependsOn": ["^build"],
      "env": ["TEST_DATABASE_URL"]
    }
  }
}
