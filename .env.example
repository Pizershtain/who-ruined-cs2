# Docker Compose reads a copied .env; native Node processes do not. For native
# DATA_DIR/DATABASE_URL/API_URL values use docs/development.md.
POSTGRES_DB=who_ruined_cs2
POSTGRES_USER=who_ruined_cs2
# Required only when invoking Docker Compose directly. scripts/dev-up.ps1
# generates and supplies an ignored per-worktree value automatically.
POSTGRES_PASSWORD=replace-with-a-local-random-secret
POSTGRES_PORT=54329
LOCAL_DATA_DIR=./_local-dev/data
MAX_UPLOAD_BYTES=536870912
MIN_UPLOAD_FREE_BYTES=268435456
PARSE_TIMEOUT_MS=120000
RETAIN_SOURCE_DEMO=0
WORKER_POLL_MS=1000
JOB_LEASE_MS=30000
JOB_HEARTBEAT_MS=5000
MAX_JOB_ATTEMPTS=3
CHILD_KILL_GRACE_MS=5000
MAX_PARSE_ARTIFACT_BYTES=536870912
MAX_PARSE_ARTIFACT_OUTPUT_BYTES=1610612736
MAX_REPLAY_PARSE_ARTIFACT_BYTES=67108864
MAX_REPLAY_PARSE_ARTIFACT_OUTPUT_BYTES=268435456
MAX_REPLAY_ROUND_COMPRESSED_BYTES=8388608
MAX_REPLAY_TOTAL_COMPRESSED_BYTES=67108864
ENABLE_EXPERIMENTAL_PARTICIPATION_RATING=0
API_BIND_HOST=127.0.0.1
API_PORT=3000
API_CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173,http://127.0.0.1:5174,http://localhost:5174
API_REQUEST_TIMEOUT_MS=1800000
API_HEADERS_TIMEOUT_MS=15000
API_KEEP_ALIVE_TIMEOUT_MS=5000
MAX_JSON_BODY_BYTES=131072
MAX_QUERY_STRING_BYTES=8192
MAX_CONCURRENT_UPLOADS=2
MAX_QUEUED_JOBS=32
MAX_RESULT_COMPRESSED_BYTES=8388608
MAX_RESULT_JSON_BYTES=67108864
MAX_RESULT_JSON_DEPTH=128
